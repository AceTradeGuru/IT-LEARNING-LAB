# CarrierGuard environment. Copy to .env for local overrides.
# .env is gitignored — never commit real values.

# 'development' or 'production'. Production refuses to start without
# SECRET_KEY and DATABASE_URL set, and turns on secure cookies.
APP_ENV=development

# Defaults to the docker-compose Postgres on port 5433 when unset.
# DATABASE_URL=postgresql://carrierguard:localdev@localhost:5433/carrierguard

# Signs session cookies. Generate with:  python3 -c "import secrets;print(secrets.token_hex(32))"
# Development auto-generates an ephemeral one; production requires this.
# SECRET_KEY=

# Connection pool sizing. Managed Postgres caps connections well below what
# most people assume — keep DB_POOL_MAX * worker_count under your plan's limit.
DB_POOL_MIN=1
DB_POOL_MAX=10
WEB_CONCURRENCY=3

# External data sources. Absent in development; the ingest job falls back to
# seeded data and reports that it did, rather than pretending it refreshed.
FMCSA_WEBKEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Warn when carrier records go this many days without a refresh.
CARRIER_STALE_DAYS=3
