# Copy to .env and fill in. Never commit the real file.

QUOTAOS_ENV=production
QUOTAOS_DEBUG=0

# Required in production. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Requires HTTPS. Leave on in production.
SESSION_COOKIE_SECURE=1
SESSION_HOURS=12

# Claude-backed hiring features. Without it the app runs the offline engine.
ANTHROPIC_API_KEY=

# Per-org guardrails on model spend.
AI_CALLS_PER_HOUR=60
AI_SEARCH_MAX_CANDIDATES=60

# Retention clock on candidate personal data, in days.
CANDIDATE_RETENTION_DAYS=365

# Postgres, once migrated off SQLite.
DATABASE_URL=
