# Copy to .env and fill in. Never commit the real file.

GRIND_ENV=production
GRIND_DEBUG=0

# Required in production. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Requires HTTPS. Leave on in production.
SESSION_COOKIE_SECURE=1
SESSION_HOURS=12

# Postgres. Unset means SQLite, which is fine locally and not fine in production.
DATABASE_URL=

# ---------------------------------------------------------------- the model --
# Without it the app runs the offline template engine and says so on every page.
ANTHROPIC_API_KEY=

# Per-org guardrails on model spend. The monthly dollar cap lives on the org row
# (orgs.ai_cents_cap); these are the process-level limits.
AI_CALLS_PER_HOUR=120
AI_SEARCH_MAX_COMPANIES=80

# ------------------------------------------------------------- the telephony --
# 'simulated' needs nothing and places no calls. 'vonage' needs all four values
# below, and the app refuses to boot in production without them.
TELEPHONY_PROVIDER=simulated
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY=
VONAGE_NUMBER=

# Where Vonage posts call events. Must be publicly reachable over HTTPS.
PUBLIC_BASE_URL=

# Signs the callback URL. The webhook writes transcripts into a multi-tenant
# database, so it is not optional in production.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TELEPHONY_WEBHOOK_SECRET=

# ------------------------------------------------------------- the data layer --
# 'offline' simulates verification and labels every result as simulated.
ENRICHMENT_PROVIDER=offline
ENRICHMENT_PROVIDER_URL=
ENRICHMENT_API_KEY=

# A verification older than this stops counting as one.
VERIFICATION_TTL_DAYS=90

# Retention clock on prospect personal data, in days. Per-org override lives on
# orgs.retention_days.
RETENTION_DAYS=730
